# Supabase — find these in your project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access — choose a strong password and a random 32+ character secret
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Scout agent (scripts/scout) — corpus gap analysis → Notion proposals.
# Read-only against Supabase and Notion; the only write is creating provisional
# Content Prospect List rows through the contract hook.
# ---------------------------------------------------------------------------
# Anthropic API key for the Scout agent (Sonnet 5).
ANTHROPIC_API_KEY=
# Notion internal-integration token; the integration must have the Content
# Prospect List shared with it (read + insert).
NOTION_TOKEN=
# Supabase read credentials for the coverage map. The Scout only ever SELECTs,
# but Row-Level Security blocks the anon key from reading authors/texts (the
# coverage map comes back empty), so use the service_role key here — or a
# dedicated read-only role that can read past RLS. URL is the project's API URL
# (https://<ref>.supabase.co, no path/trailing slash).
SCOUT_SUPABASE_URL=
SCOUT_SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Sourcer agent (scripts/sourcer) — acquire the editor-pinned, rights-cleared
# edition, clean it deterministically, detect (never correct) risky OCR, and
# stage a reviewable draft bundle under content/staging/. Never writes the live
# database, never publishes. Reuses ANTHROPIC_API_KEY + NOTION_TOKEN above.
# ---------------------------------------------------------------------------
# Supabase READ-ONLY credentials for dedup + author checks. Grant a SELECT-only
# role (NOT service_role). Falls back to NEXT_PUBLIC_SUPABASE_* if unset.
SOURCER_SUPABASE_URL=
SOURCER_SUPABASE_KEY=
# Optional: override the reasoning model (default claude-sonnet-5).
# SOURCER_MODEL=

# ---------------------------------------------------------------------------
# Umami analytics reporting (scripts/umami-report.mjs) — READ-ONLY.
# Umami Cloud gates its API-key API behind a paid plan, so on the free tier use
# the per-website Share URL instead: in Umami go Websites -> (site) -> Edit ->
# Share URL and toggle it on. Easiest: paste the WHOLE share link here — the
# resolver parses the Cloud region (Umami Cloud is regionalised, US/EU) and the
# slug from it. The link is public + read-only, so it is not a secret, but keep
# it here rather than committed so the reporting target stays configurable.
# e.g. UMAMI_SHARE_URL=https://cloud.umami.is/analytics/eu/share/RVTyHqAJ5ieccIXu
UMAMI_SHARE_URL=
# Alternative to the full URL: the bare slug plus the region (eu | us).
# UMAMI_SHARE_ID=
# UMAMI_REGION=eu
# The Stromata's website id (not secret; also embedded in the tracking script).
UMAMI_WEBSITE_ID=36255fb6-66a4-4bcf-9065-65f7a74a3944
# Optional — only if you upgrade to a paid plan and want API-key auth instead
# of the share token. When set, it takes precedence over the share options.
# UMAMI_API_KEY=
# Optional: pin the resolved API base to skip endpoint probing (run
# `npm run umami -- doctor` once; it prints the base to pin here). For EU-region
# Cloud share access this is the regional gateway:
# UMAMI_API_BASE=https://gateway-eu.umami.is/api
# Analytics digest (scripts/analytics/digest.mjs) joins Umami events to the
# corpus, so it needs a Supabase READ key. Optional dedicated vars; otherwise it
# falls back to SCOUT_SUPABASE_* / NEXT_PUBLIC_SUPABASE_URL + a read key. RLS
# hides authors/texts from the anon key, so use service-role or a read role.
# ANALYTICS_SUPABASE_URL=
# ANALYTICS_SUPABASE_KEY=
