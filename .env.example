# Supabase — find these in your project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access — choose a strong password and a random 32+ character secret
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Scout agent (scripts/scout) — corpus gap analysis → Notion proposals.
# Read-only against Supabase and Notion; the only write is creating provisional
# Content Prospect List rows through the contract hook.
# ---------------------------------------------------------------------------
# Anthropic API key for the Scout agent (Sonnet 5).
ANTHROPIC_API_KEY=
# Notion internal-integration token; the integration must have the Content
# Prospect List shared with it (read + insert).
NOTION_TOKEN=
# Supabase read credentials for the coverage map. The Scout only ever SELECTs,
# but Row-Level Security blocks the anon key from reading authors/texts (the
# coverage map comes back empty), so use the service_role key here — or a
# dedicated read-only role that can read past RLS. URL is the project's API URL
# (https://<ref>.supabase.co, no path/trailing slash).
SCOUT_SUPABASE_URL=
SCOUT_SUPABASE_KEY=
