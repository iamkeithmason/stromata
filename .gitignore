# Pipeline — raw source downloads (large binary/text files)
scripts/ingestion/sources/

# Pipeline — corpus word-frequency index (build artefact, rebuilt from the DB)
data/corpus-frequency.json

# Scratch scripts — underscore-prefixed one-off helpers, never committed
scripts/_*

# Transient agent worktrees (created by Claude Code subagent isolation)
.claude/worktrees/
# Pipeline — page-image crops fetched from Archive.org (re-fetchable, ~22MB
# for one text). The TRANSCRIPTS and manifest beside them are NOT ignored:
# they are the irreplaceable half of the work, the crops are a download.
scripts/ingestion/work/*/pages/

# Screens reference — the per-shot JPEGs (`npm run screens --png`). The PDF beside
# them IS committed; these are a by-product, regenerated on every run.
docs/screens/png/
