{
  "name": "stromata",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "umami": "node scripts/umami-report.mjs",
    "umami:digest": "node scripts/analytics/digest.mjs",
    "generate:note-drafts": "node scripts/generate-note-drafts.mjs",
    "generate:summaries": "node scripts/generate-summaries.mjs",
