    "repair:summaries": "node scripts/repair-summaries.mjs",
    "strip:source-chrome": "node scripts/strip-source-chrome.mjs",
    "pipeline:status": "node -e \"import('./scripts/ingestion/prospect-queue.json', {assert:{type:'json'}}).then(m=>m.default.prospects.forEach(p=>console.log(p.status.padEnd(16), p.id)))\"",
    "pipeline:import": "node scripts/pipeline-import.mjs && tsx scripts/backfill-scripture-refs.ts",
    "backfill:scripture": "tsx scripts/backfill-scripture-refs.ts",
    "scout": "tsx scripts/scout/scout.ts",
    "scout:apply": "tsx scripts/scout/scout.ts --apply",
    "test:scout": "tsx --test scripts/scout/*.test.ts",
    "sourcer": "tsx scripts/sourcer/sourcer.ts",
    "sourcer:apply": "tsx scripts/sourcer/sourcer.ts --apply",
    "test:sourcer": "tsx --test scripts/sourcer/*.test.ts",
    "research": "tsx scripts/research/research.ts",
    "test:research": "tsx --test scripts/research/*.test.ts",
    "design:critic": "node scripts/design/critic-loop.mjs",
    "test": "tsx --test \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "check:tests-in-ci": "node scripts/check-tests-in-ci.mjs",
    "check:prospect-urls": "node scripts/check-prospect-urls.mjs",
    "screens": "node scripts/screens/render.mjs",
    "screens:canvas": "node scripts/screens/canvas.mjs",
    "ornaments:svg": "tsx scripts/design/write-ornament-svgs.ts",
    "mark:svg": "tsx scripts/design/write-mark-svgs.ts",
    "mark:icons": "tsx scripts/design/render-icons.mjs",
    "check:cards": "node scripts/check-card-names.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tailwindcss/typography": "^0.5.19",
    "bible-passage-reference-parser": "^4.0.0",
    "jose": "^5.9.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@anthropic-ai/sdk": "^0.96.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
    "pdfkit": "^0.20.1",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "turndown": "^7.2.4",
    "typescript": "^5",
    "zod": "^4.4.3"
  }
